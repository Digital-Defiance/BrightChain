{
  "name": "brightchain-db",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "brightchain-db/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:db"],
  "implicitDependencies": ["brightchain-lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/brightchain-db",
        "main": "brightchain-db/src/index.ts",
        "tsConfig": "brightchain-db/tsconfig.lib.json",
        "assets": [
          {
            "input": "brightchain-db",
            "glob": "*.md",
            "output": "."
          },
          {
            "input": "brightchain-db",
            "glob": "package.json",
            "output": "."
          }
        ]
      },
      "dependsOn": ["^build"],
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "brightchain-db/jest.config.ts",
        "passWithNoTests": true
      },
      "cache": true
    },
    "conformance-pr": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "brightchain-db/jest.config.ts",
        "testPathPatterns": [
          "src/lib/v2/conformance",
          "src/__tests__/conformance"
        ],
        "passWithNoTests": false
      },
      "cache": false
    },
    "conformance-replay": {
      "executor": "nx:run-commands",
      "options": {
        "forwardAllArgs": false,
        "env": {
          "CONFORMANCE_REPLAY": "1"
        },
        "command": "yarn nx test brightchain-db --testPathPatterns=src/lib/v2/conformance/replay --skip-nx-cache"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm publish --access public",
        "cwd": "dist/brightchain-db"
      }
    }
  }
}
